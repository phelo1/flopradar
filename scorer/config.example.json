  "speed": {
    "http_good_ms": 300,
    "http_bad_ms": 5000,
    "ttft_good_ms": 800,
    "ttft_bad_ms": 15000,
    "total_good_ms": 2000,
    "total_bad_ms": 30000
  },
  "cost": {
    "good_flop_per_answer": 0.01,
    "bad_flop_per_answer": 10
  },
  "voting": {
    "max_weight": 0.15,
    "full_weight_at_effective_votes": 50,
    "voter_weights": {
      "anonymous": 0.2,
      "wallet_signed": 1.0,
      "wallet_with_settled_sessions": 3.0
